# SamriddhiSetu Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ── Database ──
DATABASE_URL=postgresql://localhost:5432/nsfdc_db

# ── Supabase (Cloud Storage) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Google Gemini AI ──
GEMINI_API_KEY="Enter your gemini api"

# ── Bhashini API (Multi-lingual) ──
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── Mapbox (Geo-Spatial) ──
MAPBOX_ACCESS_TOKEN=

# ── JWT Auth ──
JWT_SECRET_KEY=change-this-to-a-secure-random-string
